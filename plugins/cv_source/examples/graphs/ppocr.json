{
  "description": "OCR / DB detection + CTC recognition",
  "graph": {
    "nodes": {
      "camera": {
        "kind": "source"
      },
      "text": {
        "kind": "model",
        "model": "ppocr_det.onnx",
        "pre": {
          "width": 640,
          "height": 640,
          "resize": "letterbox",
          "color": "bgr",
          "dtype": "f32",
          "scale": 0.0039215686,
          "mean": [
            0.485,
            0.456,
            0.406
          ],
          "std": [
            0.229,
            0.224,
            0.225
          ],
          "layout": "nchw"
        },
        "decode": {
          "type": "ocr_det",
          "output": "4",
          "threshold": 0.3,
          "min_area": 30
        }
      },
      "read": {
        "kind": "model",
        "model": "ppocr_rec.onnx",
        "pre": {
          "width": 320,
          "height": 48,
          "resize": "letterbox",
          "pad": 0,
          "color": "bgr",
          "dtype": "f32",
          "scale": 0.0039215686,
          "mean": [
            0.5,
            0.5,
            0.5
          ],
          "std": [
            0.5,
            0.5,
            0.5
          ],
          "layout": "nchw"
        },
        "decode": {
          "type": "ctc",
          "output": "softmax_2.tmp_0"
        },
        "charset": {
          "model_metadata": "character"
        }
      },
      "read_roi": {
        "kind": "crop",
        "scale": 1.0
      }
    },
    "links": [
      {
        "from": "camera.frame",
        "to": "text.frame"
      },
      {
        "from": "camera.frame",
        "to": "read_roi.frame"
      },
      {
        "from": "text.objects",
        "to": "read_roi.objects"
      },
      {
        "from": "read_roi.regions",
        "to": "read.frame"
      }
    ]
  }
}
