{
  "description": "hands + gestures / MediaPipe palm → hand landmarks → a gesture classifier on the landmarks (a tensor link)",
  "graph": {
    "nodes": {
      "camera": {
        "type": "source"
      },
      "palm": {
        "type": "model",
        "model": "mp_palm.onnx",
        "pre": {
          "width": 192,
          "height": 192,
          "resize": "letterbox",
          "color": "rgb",
          "dtype": "f32",
          "scale": 0.0039215686,
          "layout": "nhwc"
        },
        "decode": {
          "type": "ssd_anchors",
          "boxes": "Identity",
          "scores": "Identity_1",
          "strides": [
            8,
            16,
            16,
            16
          ],
          "keypoints": 7,
          "iou": 0.3
        },
        "min_confidence": 0.5,
        "labels": [
          "palm"
        ]
      },
      "hand": {
        "type": "model",
        "model": "gesture_hand_lm.onnx",
        "pre": {
          "width": 224,
          "height": 224,
          "resize": "stretch",
          "color": "rgb",
          "dtype": "f32",
          "scale": 0.0039215686,
          "layout": "nhwc"
        },
        "decode": {
          "type": "landmarks",
          "output": "Identity",
          "points": 21,
          "dims": 3,
          "presence": "Identity_1",
          "world": "Identity_3",
          "handedness": "Identity_2"
        }
      },
      "hand_roi": {
        "type": "crop",
        "rotate": {
          "from": 0,
          "to": 2,
          "angle": 90.0
        },
        "scale": 2.6,
        "shift_y": -0.5,
        "square": true
      },
      "gesture": {
        "type": "model",
        "model": "gesture_classifier.onnx",
        "tensor_input": {
          "embedder": "gesture_embedder.onnx"
        },
        "decode": {
          "type": "classify",
          "output": "Identity",
          "softmax": false,
          "topk": 1
        },
        "labels": [
          "none",
          "closed_fist",
          "open_palm",
          "pointing_up",
          "thumb_down",
          "thumb_up",
          "victory",
          "i_love_you"
        ]
      }
    },
    "links": [
      {
        "from": "camera.frame",
        "to": "palm.frame"
      },
      {
        "from": "camera.frame",
        "to": "hand_roi.frame"
      },
      {
        "from": "palm.objects",
        "to": "hand_roi.objects"
      },
      {
        "from": "hand_roi.regions",
        "to": "hand.frame"
      },
      {
        "from": "hand.objects",
        "to": "gesture.objects"
      }
    ]
  }
}
