{
  "description": "person segmentation / alpha matte",
  "graph": {
    "nodes": {
      "camera": {
        "kind": "source"
      },
      "seg": {
        "kind": "model",
        "model": "selfie_seg.onnx",
        "pre": {
          "width": 256,
          "height": 256,
          "resize": "stretch",
          "color": "rgb",
          "dtype": "f32",
          "scale": 0.0039215686,
          "layout": "nchw"
        },
        "decode": {
          "type": "dense_map",
          "output": "alphas",
          "threshold": 0.5
        }
      }
    },
    "links": [
      {
        "from": "camera.frame",
        "to": "seg.frame"
      }
    ]
  }
}
