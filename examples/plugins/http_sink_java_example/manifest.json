{
  "manifest_version": 2,
  "id": "http-sink-java-example",
  "name": "HTTP sink (Java example)",
  "version": "0.0.1",
  "type": "SINK",
  "description": "Demo only: sends an HTTP request for each event.",
  "executable": "bin/http-sink-java-example",
  "threads": { "via": "env", "name": "JAVA_TOOL_OPTIONS", "value": "-XX:ActiveProcessorCount={n}" },
  "payload_schemas": { "in": "schema/in.json" },
  "ui": { "categories": ["Outputs", "HTTP", "Examples", "Java"] }
}
