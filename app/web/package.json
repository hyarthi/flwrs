{
  "name": "flwrs-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The flwrs web UI. Built by app/build.rs (feature web-ui) and embedded in the server.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "npm run check && vite build && node scripts/compress.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lucide/svelte": "^1.75.0",
    "@xyflow/svelte": "^1.7.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "marked": "^15.0.12",
    "svelte": "^5.58.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.9",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
